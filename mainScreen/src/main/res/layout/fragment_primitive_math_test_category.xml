<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F3F4F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1-Я КАРТОЧКА: МОИ УСПЕХИ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="#EAECEF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Заголовок в стиле "Alphabet / Shapes" со скриншота -->
                <TextView
                    android:id="@+id/tvProgressTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Мои успехи"
                    android:textColor="#6B7280"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Запись 1 -->
                <TextView
                    android:id="@+id/tvStatAddition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Сложение - 9/10"
                    android:textColor="#111827"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Запись 2 -->
                <TextView
                    android:id="@+id/tvStatSubtraction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Вычитание - 8/10"
                    android:textColor="#111827"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Запись 3 -->
                <TextView
                    android:id="@+id/tvStatMultiplication"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Умножение - 10/10"
                    android:textColor="#111827"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2-Я КАРТОЧКА: НАСТРОЙКИ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="#EAECEF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Заголовок карточки -->
                <TextView
                    android:id="@+id/tvSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:letterSpacing="0.03"
                    android:text="НАСТРОЙКИ"
                    android:textColor="#6B7280"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTasksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Заданий - 10"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimeLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Время - 20 с"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Условие - до 20"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Сложность - лёгкий"
                    android:textColor="#22C55E"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Ползунок в овальной капсуле как на скриншоте -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/slider_capsule_background"
                    android:paddingHorizontal="10dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderDifficulty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:stepSize="1.0"
                        android:value="1.0"
                        android:valueFrom="1.0"
                        android:valueTo="3.0"
                        app:haloRadius="14dp"
                        app:labelBehavior="gone"
                        app:thumbColor="#1D4ED8"
                        app:thumbRadius="7dp"
                        app:trackColorActive="#3B82F6"
                        app:trackColorInactive="#DBEAFE"
                        app:trackHeight="5dp" />
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- КНОПКА НОВЫЙ ТЕСТ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewTest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="НОВЫЙ ТЕСТ"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D95D39"
            app:cornerRadius="18dp"
            app:elevation="2dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>