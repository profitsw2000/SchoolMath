<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/titanium_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_standard_padding">

        <!-- 1-Я КАРТОЧКА: МОИ УСПЕХИ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/results_history_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/math_test_category_screen_cards_margin"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/math_test_category_screen_card_corner_radius"
            app:cardElevation="@dimen/math_test_category_screen_card_elevation"
            app:strokeColor="@color/athens_gray"
            app:strokeWidth="@dimen/math_test_category_screen_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/category_details_card_padding">

                <!-- Заголовок в стиле "Alphabet / Shapes" со скриншота -->
                <TextView
                    android:id="@+id/math_test_results_history_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/math_test_result_history_card_title_text"
                    android:layout_marginBottom="@dimen/math_test_category_details_card_title_margin_bottom"
                    android:textColor="@color/oslo_gray"
                    android:textSize="@dimen/math_test_category_details_card_title_text_size"
                    android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/math_test_result_first_raw_image_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/add_icon"
                        android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"/>

                    <!-- Запись 1 -->
                    <TextView
                        android:id="@+id/assessment_title_first_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assessment_item_text"
                        android:textColor="@color/wood_smoke"
                        android:textSize="@dimen/math_test_category_details_card_item_text_size"
                        android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/assessment_first_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4 (9/10)"
                        android:textColor="@color/wood_smoke"
                        android:textSize="@dimen/math_test_category_details_card_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Запись 1 -->
                    <TextView
                        android:id="@+id/assessment_title_first_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_item_text"
                        android:textColor="@color/wood_smoke"
                        android:textSize="@dimen/math_test_category_details_card_item_text_size"
                        android:layout_marginStart="42dp"
                        android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/assessment_first_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2:35"
                        android:textColor="@color/wood_smoke"
                        android:textSize="@dimen/math_test_category_details_card_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

                <!-- Запись 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/math_test_result_first_raw_image_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/add_icon"
                            android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"/>

                        <!-- Запись 1 -->
                        <TextView
                            android:id="@+id/assessment_title_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/assessment_item_text"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/assessment_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="3 (8/10)"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Запись 1 -->
                        <TextView
                            android:id="@+id/assessment_title_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/time_item_text"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:layout_marginStart="42dp"
                            android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/assessment_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2:03"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Запись 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/math_test_result_first_raw_image_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/add_icon"
                            android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"/>

                        <!-- Запись 1 -->
                        <TextView
                            android:id="@+id/assessment_title_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/assessment_item_text"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/assessment_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="5 (10/10)"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Запись 1 -->
                        <TextView
                            android:id="@+id/assessment_title_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/time_item_text"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:layout_marginStart="42dp"
                            android:layout_marginEnd="@dimen/math_test_category_details_card_inner_horizontal_margin"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/assessment_first_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="3:21"
                            android:textColor="@color/wood_smoke"
                            android:textSize="@dimen/math_test_category_details_card_item_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2-Я КАРТОЧКА: НАСТРОЙКИ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/math_test_category_screen_cards_margin"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/math_test_category_screen_card_corner_radius"
            app:cardElevation="@dimen/math_test_category_screen_card_elevation"
            app:strokeColor="@color/athens_gray"
            app:strokeWidth="@dimen/math_test_category_screen_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/category_details_card_padding">

                <!-- Заголовок карточки -->
                <TextView
                    android:id="@+id/settings_title_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настройки"
                    android:layout_marginBottom="@dimen/math_test_category_details_card_title_margin_bottom"
                    android:textColor="@color/oslo_gray"
                    android:textSize="@dimen/math_test_category_details_card_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTasksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Заданий - 10"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimeLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Время - 20 с"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Условие - до 20"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Сложность - лёгкий"
                    android:textColor="#22C55E"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Ползунок в овальной капсуле как на скриншоте -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/slider_capsule_background"
                    android:paddingHorizontal="10dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderDifficulty"
                        android:layout_width="327dp"
                        android:layout_height="wrap_content"
                        android:stepSize="1.0"
                        android:value="1.0"
                        android:valueFrom="1.0"
                        android:valueTo="3.0"
                        app:labelBehavior="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbColor="#1D4ED8"
                        app:thumbHeight="28dp"
                        app:thumbRadius="14dp"
                        app:thumbStrokeColor="#BFDBFE"
                        app:thumbStrokeWidth="3dp"
                        app:thumbTrackGapSize="0dp"
                        app:thumbWidth="28dp"
                        app:trackColorActive="@android:color/transparent"
                        app:trackColorInactive="@android:color/transparent"
                        app:trackHeight="28dp"
                        app:trackStopIndicatorSize="0dp" />
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- КНОПКА НОВЫЙ ТЕСТ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewTest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="НОВЫЙ ТЕСТ"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D95D39"
            app:cornerRadius="18dp"
            app:elevation="2dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>