<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchDifficultyContainer"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="@drawable/slider_capsule_background"
    android:padding="4dp">

    <!-- Скользящий белый бегунок (Thumb) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/viewSwitchThumb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="13dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.333"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp" />

    <!-- 3 кликабельные зоны с подписями поверх бегунка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabEasy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Лёгкий"
            android:textColor="#22C55E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMedium"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Средний"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabHard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Сложный"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>