<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchDifficultyContainer"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="@drawable/slider_capsule_background"
    android:padding="4dp">

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderDifficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="1.0"
        android:valueFrom="1.0"
        android:valueTo="3.0"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbColor="#1D4ED8"
        app:thumbHeight="28dp"
        app:thumbRadius="14dp"
        app:thumbStrokeColor="#BFDBFE"
        app:thumbStrokeWidth="3dp"
        app:thumbTrackGapSize="0dp"
        app:thumbWidth="28dp"
        app:trackColorActive="#3B82F6"
        app:trackColorInactive="#E2E8F0"
        app:trackHeight="14dp"
        app:trackStopIndicatorSize="0dp" />

