<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Круглая рамка (радиус 11, центр 12,12, толщина 2) -->
  <path
      android:pathData="M12,1 A11,11 0 1,1 12,23 A11,11 0 1,1 12,1 Z"
      android:strokeWidth="2"
      android:strokeColor="@color/athens_gray"
      android:fillColor="@android:color/transparent" />

  <!-- Уменьшаем внутреннюю иконку до 65% и центрируем, чтобы не задевала рамку -->
  <group
      android:pivotX="12"
      android:pivotY="12"
      android:scaleX="0.65"
      android:scaleY="0.65">
    <path
        android:pathData="M12,3L3,7.5L12,12L21,7.5L12,3Z"
        android:strokeLineJoin="round"
        android:strokeWidth="2"
        android:fillColor="@color/titanium_white"
        android:strokeColor="@color/athens_gray"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M3,12L12,16.5L21,12"
        android:strokeLineJoin="round"
        android:strokeWidth="2"
        android:fillColor="@color/titanium_white"
        android:strokeColor="@color/athens_gray"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M3,16.5L12,21L21,16.5"
        android:strokeLineJoin="round"
        android:strokeWidth="2"
        android:fillColor="@color/titanium_white"
        android:strokeColor="@color/athens_gray"
        android:strokeLineCap="round"/>
  </group>
</vector>
